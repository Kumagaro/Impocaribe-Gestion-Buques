{
  "name": "@impocaribe/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "db:create": "node src/db/cli.ts create",
    "db:migrate": "node src/db/cli.ts migrate",
    "db:reset": "node src/db/cli.ts reset",
    "db:seed": "node src/db/cli.ts seed",
    "db:generate": "drizzle-kit generate",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@impocaribe/shared": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
