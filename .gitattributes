# Finales de línea fijos (LF) en todo el repositorio, sea cual sea la configuración del equipo.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binarios: PDF de referencia, imágenes y capturas visuales (plan §13.2)
