# Copie este archivo como .env y ajuste los valores de su equipo.
# Nunca suba .env al repositorio: contiene contraseñas.

# development | test | production
NODE_ENV=development

# Puerto del servidor (plan §6)
PORT=8443

# Base de desarrollo. La de pruebas va aparte y su nombre debe terminar en _test.
DATABASE_URL=postgres://postgres:CAMBIAR@localhost:5432/impocaribe_dev
TEST_DATABASE_URL=postgres://postgres:CAMBIAR@localhost:5432/impocaribe_test

# Carpeta de datos (PDF, imágenes, respaldos). Por defecto, fuera del repositorio:
#   development: %LOCALAPPDATA%\Impocaribe\dev-data
#   test:        carpeta temporal del sistema\impocaribe-test
#   production:  C:\ProgramData\Impocaribe\data
# IMPOCARIBE_DATA_DIR=
